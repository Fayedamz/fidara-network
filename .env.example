# Copy to .env and fill in values after deploying the contract.

# The deployed Fidara contract address on Stellar Testnet.
VITE_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# Base ledger number at a known point in time (used for date estimates).
# Get this from `stellar ledger --network testnet`.
VITE_BASE_LEDGER=0

# Unix timestamp in milliseconds corresponding to VITE_BASE_LEDGER.
VITE_BASE_TIMESTAMP_MS=0
